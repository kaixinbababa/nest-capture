[Unit]
Description=Nest pre-roll daemon (DOORBELL)
After=graphical-session.target network-online.target

[Service]
Type=simple
ExecStart=%h/.venvs/nest/bin/python -u %h/.openclaw/workspace/nest-sdm/nest_warm.py "DOORBELL" --keep 6 --chunk 10
Restart=always
RestartSec=15
StandardOutput=append:%h/.local/state/nest-events/warm-DOORBELL.log
StandardError=append:%h/.local/state/nest-events/warm-DOORBELL.log

[Install]
WantedBy=default.target
